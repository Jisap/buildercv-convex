# Copia este archivo como `.env.local` para desarrollo.
# Nunca subas valores reales al repositorio.

# URL del despliegue Convex (la genera `npx convex dev`).
NEXT_PUBLIC_CONVEX_URL=
# URL del sitio Convex (la genera `npx convex dev`).
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (dashboard.clerk.com → API keys). Ver README.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/signin
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

# Solo para el dashboard de Convex (`npx convex env set`), no para Next:
# CLERK_JWT_ISSUER_DOMAIN=https://verb-noun-00.clerk.accounts.dev
# SITE_URL=http://localhost:3000
